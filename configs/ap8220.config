#
# OpenWrt 24.10 编译配置 — 阿里云 AP8220 (IPQ807x / 128MB NAND)
# 用途：AC+AP WiFi 统一管理系统固件（内置 AC 管理器 + AP 端软件包）
#
# 编写规范与注意事项：
#   1. Kconfig 不支持行内注释，所有注释独立成行
#   2. 被裁剪组件保留为注释行（#CONFIG_...=y），按需放开
#   3. AC/AP 管理包源码位于仓库 OpenWrt_AC_AP_WiFi/package/，
#      需在 diy-script-1.sh 中复制到 openwrt/package/ 后再编译
#   4. NSS / turboacc / openclash 等组件依赖 ImmortalWrt 系软件源，
#      若 openwrt-24.10 fork 未合并对应 feed，defconfig 将静默丢弃
#   5. 「AC+AP WiFi 统一管理系统」区块（CONFIG_PACKAGE_ac-manager 起）
#      为受保护区：不得删除、重命名任何 CONFIG 行或变更 =y 状态
#

# ==============================================
# 【目标平台】阿里云 AP8220 qualcommax ipq807x
# ==============================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_aliyun_ap8220=y

# 关闭不需要的feeds
# CONFIG_FEED_routing is not set
# CONFIG_FEED_video is not set

CONFIG_IMAGEOPT=y

# ==============================================
# CURL 编译选项
# ==============================================
CONFIG_LIBCURL_COOKIES=y
CONFIG_LIBCURL_CRYPTO_AUTH=y
CONFIG_LIBCURL_FILE=y
CONFIG_LIBCURL_FTP=y
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_HTTP2=y
CONFIG_LIBCURL_HTTP_AUTH=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_PROXY=y
CONFIG_LIBCURL_TFTP=y
CONFIG_LIBCURL_THREADED_RESOLVER=y
CONFIG_LIBCURL_TLS_SRP=y
CONFIG_LIBCURL_UNIX_SOCKETS=y
CONFIG_LIBCURL_ZLIB=y

# ==============================================
# 加密库配置 libsodium / mbedtls
# ==============================================
CONFIG_LIBSODIUM_MINIMAL=y
CONFIG_LOGROTATE_ACL=y

CONFIG_MBEDTLS_AESCE_C=y
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_DES_C=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=y
CONFIG_MBEDTLS_ENTROPY_FORCE_SHA256=y
CONFIG_MBEDTLS_GCM_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED=y
CONFIG_MBEDTLS_NIST_KW_C=y
CONFIG_MBEDTLS_PSA_CRYPTO_CLIENT=y
CONFIG_MBEDTLS_RSA_NO_CRT=y
CONFIG_MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT=y
CONFIG_MBEDTLS_SHA512_USE_A64_CRYPTO_IF_PRESENT=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ENABLED=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL_ENABLED=y
CONFIG_MBEDTLS_THREADING_C=y
CONFIG_MBEDTLS_THREADING_PTHREAD=y

# ==============================================
# LuCI基础与语言
# ==============================================
CONFIG_LUCI_LANG_zh_Hans=y

# ⚠️重要：ImmortalWrt master使用ucode runtime，defconfig会自动关闭此项，不要开启
# CONFIG_PACKAGE_luci-lua-runtime=y

CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_ucode-mod-lua=y

# ==============================================
# AC+AP WiFi管理套件（第三方包，需导入OpenWrt_AC_AP_WiFi源码）
# ==============================================
CONFIG_PACKAGE_ac-manager=y
CONFIG_PACKAGE_ap-manager=y
CONFIG_PACKAGE_luci-app-ac-manager=y
CONFIG_PACKAGE_rpcd-mod-ac-manager=y
CONFIG_PACKAGE_luci-i18n-ac-manager-zh-cn=y

# ==============================================
# 代理、DNS过滤套件 passwall2 + mosdns + chinadns‑ng + adblock
# ==============================================
CONFIG_PACKAGE_adblock=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_tcping=y

CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_luci-app-mosdns=y

CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y

CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y
CONFIG_PACKAGE_simple-obfs-client=y
CONFIG_PACKAGE_v2ray-plugin=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_haproxy=y

# ==============================================
# LuCI应用翻译
# ==============================================
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_luci-i18n-adblock-zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y

CONFIG_PACKAGE_luci-app-acme=y

# ==============================================
# LuCI库组件
# ==============================================
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y

# ==============================================
# WireGuard 相关
# ==============================================
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y

# ==============================================
# 核心工具、coreutils工具集
# ==============================================
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_netcat=m
CONFIG_PACKAGE_jq=m

# ==============================================
# hostapd / wpad / wpa‑supplicant 无线相关
# ==============================================
CONFIG_PACKAGE_hostapd=y
CONFIG_PACKAGE_hostapd-utils=m
CONFIG_PACKAGE_hostapd-basic=m
CONFIG_PACKAGE_hostapd-basic-mbedtls=m
CONFIG_PACKAGE_hostapd-basic-openssl=m
CONFIG_PACKAGE_hostapd-basic-wolfssl=m
CONFIG_PACKAGE_hostapd-mbedtls=m
CONFIG_PACKAGE_hostapd-mini=m
CONFIG_PACKAGE_hostapd-openssl=m
CONFIG_PACKAGE_hostapd-wolfssl=m

CONFIG_PACKAGE_wpa-supplicant=y
CONFIG_PACKAGE_wpa-supplicant-basic=m
CONFIG_PACKAGE_wpa-supplicant-mbedtls=m
CONFIG_PACKAGE_wpa-supplicant-mesh-mbedtls=m
CONFIG_PACKAGE_wpa-supplicant-mesh-openssl=m
CONFIG_PACKAGE_wpa-supplicant-mesh-wolfssl=m
CONFIG_PACKAGE_wpa-supplicant-mini=m
CONFIG_PACKAGE_wpa-supplicant-openssl=m
CONFIG_PACKAGE_wpa-supplicant-p2p=m
CONFIG_PACKAGE_wpa-supplicant-wolfssl=m
CONFIG_PACKAGE_wpa-cli=m

CONFIG_PACKAGE_wpad=m
CONFIG_PACKAGE_wpad-basic=m
CONFIG_PACKAGE_wpad-basic-mbedtls=m
CONFIG_PACKAGE_wpad-basic-openssl=m
CONFIG_PACKAGE_wpad-basic-wolfssl=m
CONFIG_PACKAGE_wpad-mbedtls=m
CONFIG_PACKAGE_wpad-mesh-mbedtls=m
CONFIG_PACKAGE_wpad-mesh-openssl=m
CONFIG_PACKAGE_wpad-mesh-wolfssl=m
CONFIG_PACKAGE_wpad-mini=m
CONFIG_PACKAGE_wpad-openssl=m
CONFIG_PACKAGE_wpad-wolfssl=m

CONFIG_PACKAGE_iwinfo=m

CONFIG_WPA_ENABLE_WEP=y
CONFIG_WPA_RFKILL_SUPPORT=y
CONFIG_WPA_WOLFSSL=y

# ==============================================
# 内核加密模块
# ==============================================
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y

# ==============================================
# 第三方附加模块
# ==============================================
CONFIG_PACKAGE_luci-app-wifi-ap=m
CONFIG_PACKAGE_rpcd-mod-rpcsys=y

# ==============================================
# 库文件
# ==============================================
CONFIG_PACKAGE_cJSON=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libev=y
CONFIG_PACKAGE_libhiredis=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_liblua5.4=y
CONFIG_PACKAGE_liblucihttp-lua=y
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_libpcre2=y
CONFIG_PACKAGE_libreadline=y
CONFIG_PACKAGE_libsodium=y
CONFIG_PACKAGE_libsqlite3=y
CONFIG_PACKAGE_libubus-lua=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_libudns=y
CONFIG_PACKAGE_libwebsockets-mbedtls=y
CONFIG_PACKAGE_libwolfssl=m
CONFIG_PACKAGE_libyaml=y
CONFIG_PACKAGE_lyaml=y

# 动态模块（=m）
CONFIG_PACKAGE_avahi-dbus-daemon=m
CONFIG_PACKAGE_dbus=m
CONFIG_PACKAGE_libacl=m
CONFIG_PACKAGE_libattr=m
CONFIG_PACKAGE_libavahi-dbus-support=m
CONFIG_PACKAGE_libdaemon=m
CONFIG_PACKAGE_libdbus=m
CONFIG_PACKAGE_libexpat=m
CONFIG_PACKAGE_libltdl=y
CONFIG_PACKAGE_libpopt=m
CONFIG_PACKAGE_logrotate=m

# ==============================================
# SQLite3编译选项
# ==============================================
CONFIG_SQLITE3_COLUMN_METADATA=y
CONFIG_SQLITE3_DYNAMIC_EXTENSIONS=y
CONFIG_SQLITE3_FTS3=y
CONFIG_SQLITE3_FTS4=y
CONFIG_SQLITE3_FTS5=y
CONFIG_SQLITE3_RTREE=y

CONFIG_WOLFSSL_HAS_NO_HW=y

# ===== NSS 硬件加速（IPQ807x 性能关键）=====
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-gmac=y
CONFIG_PACKAGE_kmod-qca-nss-ecm-standard=y
CONFIG_PACKAGE_kmod-qca-nss-cfi-crypto=y
CONFIG_PACKAGE_nss-userspace=y
CONFIG_PACKAGE_luci-app-turboacc=y
# NSS 与 shortcut-fe 二选一，已启用 NSS，故注释 SFE
#CONFIG_PACKAGE_kmod-shortcut-fe=y
#CONFIG_PACKAGE_kmod-shortcut-fe-drv=y
# SQM 与 NSS ECM 冲突（硬件转发旁路 qdisc，SQM 不生效且空耗 CPU）
#CONFIG_PACKAGE_luci-app-sqm=y
#CONFIG_PACKAGE_sqm-scripts=y


# ===== DNS 与广告过滤 =====
# dnsmasq-full 支持 dhcp-option 43（AP 通过 DHCP 自动发现 AC）
# CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq=n
# CONFIG_PACKAGE_luci-app-adblock=y

# ===== VPN（WireGuard + OpenVPN）=====
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-wireguard=y
# openvpn 是虚拟包（由 openssl/mbedtls/wolfssl 三个变体提供），不显式
# 指定变体会被 defconfig 静默丢弃，导致 luci-app-openvpn 有界面无后端；
# 固定选 openssl 变体，与 ac-manager/ap-manager 共用 libopenssl，避免双 TLS 栈
# CONFIG_PACKAGE_openvpn-openssl=y
# CONFIG_PACKAGE_luci-app-openvpn=y
# CONFIG_PACKAGE_openvpn-easy-rsa=y

# ===== 科学上网（保留 OpenClash 一套，内核由 workflow 预置 arm64）=====
# CONFIG_PACKAGE_luci-app-openclash=y
# 以下与 OpenClash 功能重叠，128MB 容量有限默认裁剪，按需放开
#CONFIG_PACKAGE_luci-app-passwall=y
#CONFIG_PACKAGE_luci-app-vssr=y
#CONFIG_PACKAGE_naiveproxy=y
#CONFIG_PACKAGE_simple-obfs=y
#CONFIG_PACKAGE_v2ray-plugin=y
#CONFIG_PACKAGE_trojan=y
#CONFIG_PACKAGE_trojan-go=y
#CONFIG_PACKAGE_xray=y
#CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
#CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y
#CONFIG_PACKAGE_libcap=y
#CONFIG_PACKAGE_libmbedtls=y
#CONFIG_PACKAGE_c-ares=y
#CONFIG_PACKAGE_libev=y
#CONFIG_PACKAGE_brook=y
#CONFIG_PACKAGE_hysteria=y
#CONFIG_PACKAGE_ehproxy=y
#CONFIG_PACKAGE_geoip-datadir=y
#CONFIG_PACKAGE_dae=y
#CONFIG_PACKAGE_ipt2socks=y

# ===== Docker（128MB NAND 不建议内置，按需放开并配合 USB extroot）=====
#CONFIG_PACKAGE_dockerd=y
#CONFIG_PACKAGE_docker-cli=y
#CONFIG_PACKAGE_luci-app-docker=y
#CONFIG_PACKAGE_cgroupfs-mount=y
#CONFIG_PACKAGE_liblxc=y
#CONFIG_PACKAGE_apparmor=y

# ===== USB 与存储扩展（外接 U 盘/SSD 时放开）=====
#CONFIG_KERNEL_SWAP=y
#CONFIG_PACKAGE_kmod-usb3=y
#CONFIG_PACKAGE_kmod-usb-storage=y
#CONFIG_PACKAGE_block-mount=y

# ===== 系统组件调整 =====
# 禁用 odhcpd（如需 IPv6 RA/DHCPv6 下发请移除此行）
CONFIG_PACKAGE_odhcpd-ipv6only=n

# ===== 调试冗余组件禁用 =====
CONFIG_PACKAGE_fail2ban=n
CONFIG_PACKAGE_flent=n
CONFIG_PACKAGE_python-babel=n
CONFIG_PACKAGE_python-docker=n
CONFIG_PACKAGE_python-incremental=n
