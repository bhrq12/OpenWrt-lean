#
# OpenWrt 24.10 编译配置 — 阿里云 AP8220 (IPQ807x / 128MB NAND)【优化版】
# 用途：AC+AP WiFi 统一管理系统固件（内置 AC 管理器 + AP 端软件包）
#
# 编写规范与注意事项：
#   1. Kconfig 不支持行内注释，所有注释独立成行
#   2. 被裁剪组件保留为注释行（#CONFIG_...=y），按需放开
#   3. AC/AP 管理包源码位于仓库 OpenWrt_AC_AP_WiFi/package/，
#      需在 diy‑script‑1.sh 中复制到 openwrt/package/ 后再编译
#   4. NSS / turboacc / openclash 等组件依赖 ImmortalWrt 系软件源，
#      若 openwrt‑24.10 fork 未合并对应 feed，defconfig 将静默丢弃
#   5.「AC+AP WiFi 统一管理系统」区块（CONFIG_PACKAGE_ac‑manager 起）
#      为受保护区：不得删除、重命名任何 CONFIG 行或变更 =y 状态
#
# ==============================================
# 【目标平台】阿里云 AP8220 qualcommax ipq807x
# ==============================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_aliyun_ap8220=y
# 关闭不需要的feeds
# CONFIG_FEED_routing is not set
# CONFIG_FEED_video is not set
CONFIG_IMAGEOPT=y

# ==============================================
# dnsmasq‑full 【AC‑AP核心：支持 DHCP‑Option43 AP自动发现AC控制器】
# ==============================================
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq=n

# ==============================================
# CURL 编译选项
# ==============================================
#CONFIG_LIBCURL_COOKIES=y
#CONFIG_LIBCURL_CRYPTO_AUTH=y
#CONFIG_LIBCURL_FILE=y
